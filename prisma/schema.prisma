// Schema from docs/spec.md section 4. Table and column names are snake_case in
// Postgres; the Prisma client uses camelCase.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShopStatus {
  building
  preview
  live
  quiet
  expired
  paused
  archived

  @@map("shop_status")
}

enum PageState {
  draft
  published

  @@map("page_state")
}

enum LinkType {
  whatsapp
  call
  google_review
  wifi
  maps
  instagram
  facebook
  youtube
  website
  menu
  custom

  @@map("link_type")
}

// The spec lists a status column for qr_codes without values. These three
// follow from "unassigned codes have no shop" and "never reuse a retired code".

enum QrStatus {
  unassigned
  assigned
  retired

  @@map("qr_status")
}

// Reasons from spec section 7. Null means the event is counted.

enum BotReason {
  crawler
  no_token
  duplicate
  rate_limit
  spike_review
  marked_bot

  @@map("bot_reason")
}

// Where a shop is on the onboarding board (slice 8). status says what the public
// sees; stage says where we are in the work.
enum OnboardingStage {
  lead
  building
  preview_sent
  printing
  live

  @@map("onboarding_stage")
}

enum Role {
  owner
  admin
  viewer

  @@map("admin_role")
}

model Plan {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  months         Int
  pricePaise     Int     @map("price_paise")
  // The regular price shown struck out on the landing page. Empty means no strike-through.
  compareAtPaise Int?    @map("compare_at_paise")
  // The standard plans (Monthly, Half yearly, Yearly) are not custom. A custom
  // plan is a length in months set for one shop, such as 17 months.
  isCustom       Boolean @default(false) @map("is_custom")

  shops Shop[]

  @@map("plans")
}

model Shop {
  id              String          @id @default(uuid()) @db.Uuid
  slug            String          @unique
  name            String
  tagline         String?
  shopType        String?         @map("shop_type")
  area            String?
  city            String?
  address         String?
  phone           String?
  whatsapp        String?
  waMessage       String?         @map("wa_message")
  logoUrl         String?         @map("logo_url")
  coverUrl        String?         @map("cover_url")
  status          ShopStatus      @default(building)
  stage           OnboardingStage @default(building)
  stageChangedAt  DateTime        @default(now()) @map("stage_changed_at")
  ownerName       String?         @map("owner_name")
  ownerWhatsapp   String?         @map("owner_whatsapp")
  notes           String?
  // Standee designer choices (spec section 11). Checked by the standee service and by
  // the migration's CHECK constraints.
  standeeDesign   String          @default("arch") @map("standee_design")
  standeeTheme    String          @default("match") @map("standee_theme")
  standeeHeadline String          @default("") @map("standee_headline")
  standeeSize     String          @default("A5") @map("standee_size")
  planId          String?         @map("plan_id") @db.Uuid
  planStartedAt   DateTime?       @map("plan_started_at")
  planEndsAt      DateTime?       @map("plan_ends_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  plan        Plan?         @relation(fields: [planId], references: [id])
  pages       ShopPage[]
  slugHistory SlugHistory[]
  links       Link[]
  qrCodes     QrCode[]
  scanEvents  ScanEvent[]
  clickEvents ClickEvent[]
  dailyStats  DailyStat[]
  changeLog   ChangeLog[]
  printFiles  PrintFile[]

  @@index([status])
  @@index([planId])
  @@map("shops")
}

enum PrintKind {
  pdf
  png
  sheet

  @@map("print_kind")
}

// One row per generated download (spec section 4). A sheet of unassigned codes
// belongs to no shop and has no design or theme; its size is the sticker size.
model PrintFile {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String?   @map("shop_id") @db.Uuid
  kind      PrintKind
  design    String?
  theme     String?
  size      String
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  fileUrl   String    @map("file_url")

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@map("print_files")
}

// config = theme, layout, font, button color override, language, offer, banner, wifi.
// Publish copies the draft row to the published row.

model ShopPage {
  shopId      String    @map("shop_id") @db.Uuid
  state       PageState
  config      Json
  publishedAt DateTime? @map("published_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, state])
  @@map("shop_pages")
}

model SlugHistory {
  id      String @id @default(uuid()) @db.Uuid
  shopId  String @map("shop_id") @db.Uuid
  oldSlug String @unique @map("old_slug")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("slug_history")
}

model Link {
  id       String   @id @default(uuid()) @db.Uuid
  shopId   String   @map("shop_id") @db.Uuid
  type     LinkType
  label    String
  target   String
  position Int      @default(0)
  enabled  Boolean  @default(true)

  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clickEvents ClickEvent[]

  @@index([shopId, position])
  @@map("links")
}

// 6 characters, no look-alike letters. Unassigned codes have no shop.

model QrCode {
  code      String   @id @db.VarChar(6)
  shopId    String?  @map("shop_id") @db.Uuid
  status    QrStatus @default(unassigned)
  batchId   String?  @map("batch_id")
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop? @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([batchId])
  @@map("qr_codes")
}

// Raw events are kept; bots are flagged, never deleted. ip_hash is salted and
// the salt rotates daily. No raw IPs. code has no foreign key on purpose so
// scans of unknown codes can still be recorded.

model ScanEvent {
  id        BigInt     @id @default(autoincrement())
  code      String     @db.VarChar(6)
  shopId    String?    @map("shop_id") @db.Uuid
  at        DateTime   @default(now())
  ipHash    String?    @map("ip_hash")
  uaFamily  String?    @map("ua_family")
  isBot     Boolean    @default(false) @map("is_bot")
  botReason BotReason? @map("bot_reason")

  shop Shop? @relation(fields: [shopId], references: [id])

  @@index([shopId, at])
  @@index([code, at])
  @@index([at])
  @@map("scan_events")
}

// Only written through /r/... A deleted link keeps its history (link_id is
// nulled) so counts stay intact.

model ClickEvent {
  id        BigInt     @id @default(autoincrement())
  shopId    String     @map("shop_id") @db.Uuid
  linkId    String?    @map("link_id") @db.Uuid
  at        DateTime   @default(now())
  ipHash    String?    @map("ip_hash")
  isBot     Boolean    @default(false) @map("is_bot")
  botReason BotReason? @map("bot_reason")

  shop Shop  @relation(fields: [shopId], references: [id])
  link Link? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([shopId, at])
  @@index([linkId, at])
  @@index([at])
  @@map("click_events")
}

// Rebuilt by the nightly job.

model DailyStat {
  shopId      String   @map("shop_id") @db.Uuid
  day         DateTime @db.Date
  scans       Int      @default(0)
  taps        Int      @default(0)
  botScans    Int      @default(0) @map("bot_scans")
  botTaps     Int      @default(0) @map("bot_taps")
  // Subset of botScans that are held for review (spike_review).
  heldScans   Int      @default(0) @map("held_scans")
  // Flagged scans and taps by bot_reason, for the Traffic quality card.
  flagReasons Json     @default("{}") @map("flag_reasons")
  tapsByLink  Json     @default("{}") @map("taps_by_link")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, day])
  @@map("daily_stats")
}

// Powers the Activity tab and Undo.

model ChangeLog {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String?  @map("shop_id") @db.Uuid
  userEmail   String   @map("user_email")
  what        String
  at          DateTime @default(now())
  undoPayload Json?    @map("undo_payload")

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, at])
  @@map("change_log")
}

// Better Auth owns user, session, account, verification and rateLimit (below,
// generated by its CLI; see scripts/auth-cli.ts). This table only adds the role.
// An account with no row here cannot use the admin.
model AdminRole {
  userId String @id @map("user_id")
  role   Role   @default(viewer)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_roles")
}

// Enabled themes and layouts, defaults by shop type, filtering switches.

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

model User {
  id              String     @id
  name            String
  email           String
  emailVerified   Boolean    @default(false)
  image           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  username        String?
  displayUsername String?
  sessions        Session[]
  accounts        Account[]
  adminRole       AdminRole?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
