# Copy to .env.local and fill in. Never commit real values.

# Neon connection string (use the pooled one). Keep sslmode=require.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate the secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: <your origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Seeded into admin_users as owner by `npm run db:seed`.
OWNER_EMAIL="you@example.com"
