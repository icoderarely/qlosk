# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection string (used by the app).
DATABASE_URL=
# Neon direct (non-pooled) connection string (used by Prisma migrations and the seed).
DIRECT_URL=

# Random string, 32+ characters:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; the live domain on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Used only by `npm run db:seed` to create the owner. Password: 12+ characters.
# Delete ADMIN_PASSWORD from .env.local after seeding.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Logo and cover uploads (Cloudinary). Copy the "API environment variable" from the
# Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave empty in development to save files under public/uploads instead.
CLOUDINARY_URL=

# Salt for the daily visitor hash on scans and taps (spec section 7). Random,
# 32+ characters:  openssl rand -base64 32   Never store raw IPs.
IP_HASH_SALT=
# WhatsApp number for every "Chat on WhatsApp" button (landing, playground and the "not activated
# yet" page). 10-digit Indian mobile or digits with country code.
WHATSAPP_NUMBER=

# The address printed into every QR code (https://yourdomain.in, no trailing path).
# The owner can also set it in Settings, which wins over this. One of the two is
# required in production: a printed code cannot be corrected later.
QR_BASE_URL=

# Protects /api/cron/daily-stats and /api/cron/plan-expiry. Random, 32+ characters:  openssl rand -base64 32
# Vercel sends it to the cron automatically once it is set on the project.
CRON_SECRET=

# Public origin of the marketing site, used for canonicals, sitemap and social cards.
# Defaults to https://qlosk.com; set it on Vercel for previews or a different domain.
SITE_URL=https://qlosk.com
