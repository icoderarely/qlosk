# Copy to .env.local and fill in. Never commit real values.

# Neon pooled connection string (used by the app).
DATABASE_URL=
# Neon direct (non-pooled) connection string (used by Prisma migrations and the seed).
DIRECT_URL=

# Random string, 32+ characters:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; the live domain on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Used only by `npm run db:seed` to create the owner. Password: 12+ characters.
# Delete ADMIN_PASSWORD from .env.local after seeding.
ADMIN_USERNAME=
ADMIN_PASSWORD=
